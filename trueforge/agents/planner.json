{
  "_comment": "AgentSpec for the BRANCHPOINT planner. Use as the `spec` in POST /api/v1/sessions {agent:{spec:...}}, or save via POST /api/v1/agents. Replace model.name with a model your TrueForge provider serves. `instructions` is omitted here because the backend supplies the canonical prompt from app/infrastructure/trueforge/prompts.py — keep one source of truth.",
  "model": { "name": "REPLACE_WITH_PROVIDER/MODEL", "params": { "temperature": 0 } },
  "mcp_servers": [
    {
      "name": "branchpoint",
      "enable_tools": [
        "branchpoint_get_incident",
        "branchpoint_get_metrics",
        "branchpoint_get_deployment",
        "branchpoint_get_feature_flags",
        "branchpoint_get_schema",
        "branchpoint_get_orders_summary",
        "branchpoint_get_reality_state"
      ],
      "preload_tools": [
        "branchpoint_get_incident",
        "branchpoint_get_metrics",
        "branchpoint_get_deployment",
        "branchpoint_get_feature_flags",
        "branchpoint_get_schema"
      ],
      "require_approval_for_tools": ["@write", "@destructive"]
    }
  ],
  "config": {
    "sandbox": { "enabled": false },
    "dynamic_sub_agents": { "enabled": false },
    "iteration_limit": 40
  }
}
