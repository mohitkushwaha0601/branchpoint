# One ignore file for the whole repo. Patterns are unanchored unless a path is
# genuinely specific to one workspace, so a second Python or Node package added
# later is covered without editing this file again.

# --- secrets -----------------------------------------------------------------
.env
.env.local
*.local

# --- python (backend/) -------------------------------------------------------
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# --- node (frontend/) --------------------------------------------------------
# Lockfiles are deliberately NOT ignored: package-lock.json is committed.
node_modules/
dist/
dist-ssr/
.vite/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- media provenance and QA scratch -----------------------------------------
# The hero's *shipped* assets are the six files in frontend/public/hero/, and
# those are committed. These two are the working material that produced them and
# the evidence gathered while checking them — useful on disk, but not something
# a clone needs to carry.
#
# hero-archive/ holds the pre-composite ambient masters the baked-monitor cuts
# were composited from. They are mirrored outside the repo in
# ~/branchpoint-hero-work/, so ignoring them here loses nothing.
hero-archive/
# Playwright CLI page dumps and console logs from hero QA runs.
.playwright-cli/

# --- editors and os ----------------------------------------------------------
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.claude/
venv/.env
venv/
