# Where the browser should send API calls.
#
# Leave EMPTY for local development: `npm run dev` proxies /api and /health to
# the backend, so the browser stays same-origin and CORS never applies.
#
# Set it only for a deployed frontend whose backend is on another origin, e.g.
#   VITE_API_BASE_URL=https://branchpoint-backend.up.railway.app
# and add that frontend's exact origin to the backend's
# BRANCHPOINT_CORS_ALLOW_ORIGINS.
#
# No model, TrueForge, or sandbox credential belongs in this file: everything
# here is compiled into a public bundle.
VITE_API_BASE_URL=
