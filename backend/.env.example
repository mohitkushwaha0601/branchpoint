BRANCHPOINT_ENV=development
BRANCHPOINT_LOG_LEVEL=INFO
BRANCHPOINT_TRUEFORGE_URL=http://localhost:8790

# The one model every BRANCHPOINT agent (planner and DOPPELGANGER) runs on.
# A fully-qualified name TrueForge understands, e.g. provider/model.
# BRANCHPOINT treats it as opaque and never parses it.
# The provider API key belongs in TrueForge, never in this repo.
BRANCHPOINT_MODEL=

# Deprecated: still honoured, but only when BRANCHPOINT_MODEL is unset.
BRANCHPOINT_TRUEFORGE_MODEL=openai/gpt-5-6-sol
