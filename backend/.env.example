BRANCHPOINT_MODEL=

# Deprecated compatibility only — keep empty
BRANCHPOINT_TRUEFORGE_MODEL=

# Give DOPPELGÄNGER sessions a TrueForge sandbox for exploratory execution.
# Opt-in: unset means off, which is also what this file's value says.
# DOPPELGÄNGER only — the planner and the commit operator never get one.
# Sandbox output is always recorded machine_verifiable=false and can never veto.
BRANCHPOINT_TRUEFORGE_SANDBOX_ENABLED=false
